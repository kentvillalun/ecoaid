// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlackListedToken {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}


model PasswordResetToken {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
}

model OtpVerification {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber   String
  code          String

  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([phoneNumber])
}


model Barangay {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  municipality String?
  province String?
  zipCode        String? @unique
  logoUrl String?
  redemptionMode RedemptionMode @default(POINTS)

  hasCollectionRequests Boolean @default(true)
  hasRedemptionManagement Boolean @default(false)
  hasRewardInventory Boolean @default(false)
  hasLeaderboard Boolean @default(false)

  isRegistered Boolean @default(true)
  users        User[]
  sitios       Sitio[]
  contactNumber String? @unique @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  material Material[]
  program Program[]
  manualIntakeTransaction ManualIntakeTransaction[]
  stockTransactionLog StockTransactionLog[]
  junkshop Junkshop[]
  announcement Announcement[]
  programExpense ProgramExpense[]
}

enum RedemptionMode {
  POINTS
  CASH
  BOTH
}

model Sitio {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  barangayId String   @db.Uuid
  barangay   Barangay @relation(fields: [barangayId], references: [id])
  users      User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barangayId, name])
  @@index([barangayId])
}

enum Role {
  RESIDENT
  SUPER_ADMIN
  CAPTAIN
  SECRETARY
  TREASURER
  SK
  COLLECTOR
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  barangayId String? @db.Uuid
  barangay Barangay? @relation(fields: [barangayId], references: [id])
  sitioId    String?   @db.Uuid
  sitio      Sitio?    @relation(fields: [sitioId], references: [id])

  role Role @default(RESIDENT)

  phoneNumber String @unique @db.VarChar(20)
  username String? @unique 

  firstName String?
  lastName String?

  address String?
  purok String?
  isVerified Boolean? @default(false)

  passwordHash String 

  termsAccepted Boolean @default(false)
  termsAcceptedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupRequest PickupRequests[]
  manualIntakeTransaction ManualIntakeTransaction[] @relation("ResidentIntakes")
  collectedIntakeTransaction ManualIntakeTransaction[] @relation("CollectorIntakes")
  stockTransactionLog StockTransactionLog[]
  junkshopSales JunkshopSale[]
  announcement Announcement[]
  programExpense ProgramExpense[]
  
  @@index([barangayId])
  @@index([sitioId])
}

model PickupRequests {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  
  materialId String? @db.Uuid
  material Material? @relation(fields: [materialId], references: [id])

  estimatedValue Float 
  estimatedUnit Unit @default(KG)
  status Status @default(REQUESTED)
  photoUrl String
  isScheduled Boolean @default(false)

  notes String?
  actualWeight Float?
  rewardEquivalent String?
  rejectionReason String?

  createdAt DateTime @default(now())
  approvedAt DateTime?
  collectedAt DateTime?
  rejectedAt DateTime?
  isAssorted Boolean @default(false)

  collectionItems CollectionItem[]
  stockTransactionLog StockTransactionLog[]
}

model Category {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  material Material[]
}

model Material {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  categoryId String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id])

  barangayId String @db.Uuid
  barangay Barangay @relation(fields: [barangayId], references: [id])

  defaultUnit Unit @default(KG)

  isActive Boolean @default(true)
  acceptNonSellable Boolean @default(false)

  pickupRequest PickupRequests[]
  collectionItem CollectionItem[]
  programMaterial ProgramMaterial[]
  manualIntakeItems ManualIntakeItems[]
  stockTransactionLog StockTransactionLog[]
  junkshopPriceItems JunkshopPriceItem[]
  junkshopSaleItems JunkshopSaleItem[]

  @@unique([name, barangayId])
}

enum Unit {
  KG
  GRAMS
  LBS
  PIECE
}

enum Status {
  REQUESTED
  APPROVED
  IN_PROGRESS
  COLLECTED
  REJECTED
}

model CollectionItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  requestId String @db.Uuid
  request PickupRequests @relation(fields: [requestId], references: [id])

  materialId String @db.Uuid
  material Material @relation(fields: [materialId], references: [id])

  actualValue Float
  actualUnit Unit

}

model Program {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  barangayId String @db.Uuid
  barangay Barangay @relation(fields: [barangayId], references: [id])

  name String
  allotedBudget Float
 
  description String?
  isActive Boolean @default(true)
  isCashMode Boolean @default(false)
  createdAt DateTime @default(now()) 
  
  programMaterial ProgramMaterial[]
  redemptionTransaction RedemptionTransaction[]
  expenses ProgramExpense[]
}

model ProgramMaterial {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId String @db.Uuid
  program Program @relation(fields: [programId], references: [id])

  materialId String @db.Uuid
  material Material @relation(fields: [materialId], references: [id])

  pointValue Float?
  cashValue Float?
  createdAt DateTime @default(now())

  redemptionTransactionItem RedemptionTransactionItem[]

  @@unique([programId, materialId])
}

model RedemptionTransaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  programId String @db.Uuid
  program Program @relation(fields: [programId], references: [id])

  collectorName String
  beneficiaryName String
  createdAt DateTime @default(now())

  educationalLevel EducationalLevel?

  redemptionTransactionItem RedemptionTransactionItem[]
  stockTransactionLog StockTransactionLog[]
}

model RedemptionTransactionItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  transactionId String @db.Uuid
  redemptionTransaction RedemptionTransaction @relation(fields: [transactionId], references: [id])

  programMaterialId String @db.Uuid
  programMaterial ProgramMaterial @relation(fields: [programMaterialId], references: [id])

  amount Float
  currentValue Float
  createdAt DateTime @default(now())
}

enum EducationalLevel {
  PRIMARY
  SECONDARY
  TERTIARY
}

model ManualIntakeTransaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String? @db.Uuid
  user User? @relation("ResidentIntakes", fields: [userId], references: [id])

  collectorId String @db.Uuid
  collector User @relation("CollectorIntakes", fields: [collectorId], references: [id])

  barangayId String @db.Uuid
  barangay Barangay @relation(fields: [barangayId], references: [id])

  householdName String? 
  collectorName String?

  createdAt DateTime @default(now())

  manualIntakeItems ManualIntakeItems[]
  stockTransactionLog StockTransactionLog[]
}

model ManualIntakeItems {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  transactionId String @db.Uuid
  manualIntakeTransaction ManualIntakeTransaction @relation(fields: [transactionId], references: [id])

  materialId String @db.Uuid
  material Material @relation(fields: [materialId], references: [id])

  quantity Float
  unit Unit @default(KG)
}

enum TransactionType {
  IN
  OUT
}

enum Source {
  MANUAL_INTAKE
  COLLECTION_REQUEST
  MANUAL_ADJUSTMENT
  REDEMPTION
  JUNKSHOP_SALES
}

model StockTransactionLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  barangayId String @db.Uuid()
  barangay Barangay @relation(fields: [barangayId], references: [id])

  userId String? @db.Uuid()
  user User? @relation(fields: [userId], references: [id])

  materialId String @db.Uuid
  material Material @relation(fields: [materialId], references: [id])

  collectionRequestId String? @db.Uuid()
  pickupRequest PickupRequests? @relation(fields: [collectionRequestId], references: [id])

  manualIntakeTransactionId String? @db.Uuid()
  manualIntakeTransaction ManualIntakeTransaction? @relation(fields: [manualIntakeTransactionId], references: [id])

  redemptionTransactionId String? @db.Uuid()
  redemptionTransaction RedemptionTransaction? @relation(fields: [redemptionTransactionId], references: [id])

  junkshopSalesId String? @db.Uuid()
  junkshopSale JunkshopSale? @relation(fields: [junkshopSalesId], references: [id])
  performedBy String? 

  quantity Float
  unit Unit @default(KG)
  source Source @default(COLLECTION_REQUEST)

  transactionType TransactionType @default(IN)

  createdAt DateTime @default(now())
}

model Junkshop {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid()

  barangayId String @db.Uuid()
  barangay Barangay @relation(fields: [barangayId], references: [id])

  name String
  description String?
  location String?
  isAvailable Boolean @default(true)
  createdAt DateTime @default(now())

  priceItems JunkshopPriceItem[]
  sales JunkshopSale[]
}

model JunkshopPriceItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid()

  junkshopId String @db.Uuid()
  junkshop Junkshop @relation(fields: [junkshopId], references: [id])

  materialId String @db.Uuid()
  material Material @relation(fields: [materialId], references: [id])

  price Float
  unit Unit @default(KG)

  @@unique([junkshopId, materialId])
}

model JunkshopSale {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid()

  junkshopId String @db.Uuid()
  junkshop Junkshop @relation(fields: [junkshopId], references: [id])

  userId String? @db.Uuid()
  user User? @relation(fields: [userId], references: [id])

  performedBy String?
  createdAt DateTime @default(now())

  saleItems JunkshopSaleItem[]
  stockTransactionLog StockTransactionLog[]
}

model JunkshopSaleItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid()

  saleId String @db.Uuid()
  junkshopSale JunkshopSale @relation(fields: [saleId], references: [id])

  materialId String @db.Uuid()
  material Material @relation(fields: [materialId], references: [id])

  quantity Float
  cost Float
  unit Unit @default(KG)
}

enum AnnouncementCategory {
  EVENT
  REMINDER
  GENERAL
  NOTICE
  ALERT
}

model Announcement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid()

  barangayId String @db.Uuid()
  barangay Barangay @relation(fields: [barangayId], references: [id])

  userId String? @db.Uuid()
  user User? @relation(fields: [userId], references: [id])

  title String
  content String

  category AnnouncementCategory @default(GENERAL)

  performedBy String
  performedByRole String

  createdAt DateTime @default(now())
}

model ProgramExpense {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid()

  userId String? @db.Uuid()
  user User? @relation(fields: [userId], references: [id])
  
  programId String @db.Uuid()
  program Program @relation(fields: [programId], references: [id])

  barangayId String @db.Uuid()
  barangay Barangay @relation(fields: [barangayId], references: [id])

  name String
  amount Float
  description String
  performedBy String
  performedByRole String

  createdAt DateTime @default(now())
}